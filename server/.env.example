PORT=5000
MONGODB_URI=mongodb://localhost:27017/pethome
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
JWT_EXPIRE=7d
NODE_ENV=development

# 实名认证接口配置（实际项目需要接入公安系统）
REALNAME_API_URL=
REALNAME_API_KEY=

# 图片存储配置
UPLOAD_PATH=./uploads
MAX_IMAGE_SIZE=5242880

# WebSocket 配置
WS_ORIGIN=*
